# NextLife environment variables example
# Copy this file to .env and fill in real values. Never commit .env.

# Server configuration
NEXTLIFE_ENV=production
NEXTLIFE_PORT=8081
NEXTLIFE_HOST=127.0.0.1

# Database connection (PostgreSQL)
NEXTLIFE_DSN=postgresql+psycopg2:///nextlife?host=/var/run/postgresql

# Security tokens
NEXTLIFE_WEB_TOKEN=replace_with_secure_random_token
NEXTLIFE_OPENCLAW_TOKEN=replace_with_openclaw_skill_token
PHONEBROKER_TOKEN_NEXTLIFE=replace_with_phonebroker_token

# Storage paths
NEXTLIFE_DATA_DIR=/var/lib/nextlife/data
NEXTLIFE_MEDIA_DIR=/var/lib/nextlife/media

# Marketplace credentials (optional / configured per platform)
BAZOS_CZ_ACCOUNT_EMAIL=seller@example.com
BAZOS_CZ_ACCOUNT_PHONE=+420000000000
BAZOS_CZ_ACCOUNT_PASSWORD=replace_with_password
