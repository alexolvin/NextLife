# NextLife .gitignore (following GITHUB_PUBLICATION_STANDARD.md §7)

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
credentials.json
secrets.yaml
secrets.yml
kubeconfig
*.kubeconfig
.git/credentials

# Agent / local AI tooling (never publish per §1.4 & §7)
.agent/
.agents/
.a/
.claude/
.gemini/
.codex/
.cursor/
.aider/
.continue/
.windsurf/
.sweep/
.goose/
.idea-agent/
*.agent.md
.scratch/
AGENTS.md
GEMINI.md
ui-check/run/
acceptance/
correction/
reports/
ui-audit/
BEFORE_DEPLOY.MD
traceability.csv
.qwen/

# Terminal sessions, multiplexers, and distributed-agent runtime
*.tmux
*.tmux.log
tmux-client-*
tmux-server-*
screenlog.*
*.screenlog
zellij-dump*
nohup.out
*.cast
typescript
.typescript
pane-capture*
session-dump*
.queue/
.jobs/
.runs/
gpu-pool/
workers/*.log
dispatcher-state.json
*.queue.json
tmux-sessions/
terminal-dumps/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json.example

# Logs and caches
*.log
.cache/
tmp/
temp/
driver.log

# Python / dependencies and build output
dist/
build/
target/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
eggs/
.eggs/
*.egg-info/
*.egg
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
.coverage
htmlcov/
report/
.jscpd/
data/
lib/
