[Unit]
Description=NextLife API and Web-UI Service
After=network.target nextlife-nft.service
Wants=nextlife-nft.service

[Service]
Type=simple
User=nextlife
Group=nextlife
WorkingDirectory=/opt/nextlife/app
# Single secret source (web/openclaw/phonebroker tokens)
EnvironmentFile=/opt/nextlife/app/.env
# DSN: peer via unix socket, no password. Data dir + publish kill-switch.
Environment=NEXTLIFE_DSN=postgresql+psycopg2:///nextlife?host=/var/run/postgresql
Environment=NEXTLIFE_DATA_DIR=/var/lib/nextlife
Environment=NEXTLIFE_PUBLISH_DRY_RUN=1
ExecStart=/opt/nextlife/venv/bin/nextlife-api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nextlife
PrivateTmp=true

[Install]
WantedBy=multi-user.target
