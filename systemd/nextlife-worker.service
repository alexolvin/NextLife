[Unit]
Description=NextLife Job Worker Service
After=network.target nextlife-web.service
Wants=nextlife-web.service

[Service]
Type=simple
User=nextlife
Group=nextlife
WorkingDirectory=/opt/nextlife/app
EnvironmentFile=-/opt/nextlife/app/.env
Environment=NEXTLIFE_DATA_DIR=/var/lib/nextlife
ExecStart=/opt/nextlife/venv/bin/nextlife-worker
Restart=always
RestartSec=3
TimeoutStopSec=5
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/nextlife /opt/nextlife
PrivateTmp=true

[Install]
WantedBy=multi-user.target
